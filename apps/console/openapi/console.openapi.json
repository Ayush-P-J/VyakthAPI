{
  "openapi": "3.1.0",
  "info": { "title": "Hexspare console API", "version": "1", "description": "The API behind the developer console. The console reaches it at /console-api, which maps to /console/v1 on the API." },
  "paths": {
    "/auth/signup": { "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SignupRequest" } } } }, "responses": { "201": { "description": "Account created and signed in", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Profile" } } } } } } },
    "/auth/login": { "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } }, "responses": { "200": { "description": "Signed in", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Profile" } } } } } } },
    "/auth/logout": { "post": { "responses": { "204": { "description": "Signed out" } } } },
    "/me": { "get": { "responses": { "200": { "description": "The signed-in user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Profile" } } } } } } },
    "/projects/{id}/overview": { "get": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Counts for one project", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectOverview" } } } } } } },
    "/projects": { "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewProjectRequest" } } } }, "responses": { "201": { "description": "Project created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } } } } } },
    "/projects/{id}/api-keys": { "get": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Keys, newest first, revoked last", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiKeyList" } } } } } }, "post": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewApiKeyRequest" } } } }, "responses": { "201": { "description": "Created. The only response containing the key", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatedApiKey" } } } } } } },
    "/projects/{id}/api-keys/{keyId}": { "delete": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "keyId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Revoked" } } } },
    "/projects/{id}/connections": { "get": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Connected companies and their status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConnectionList" } } } } } } },
    "/projects/{id}/connections/{connectionId}": { "delete": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "connectionId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Revoked" } } } },
    "/projects/{id}/connect-links": { "get": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "The latest 50 links, without their secrets", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConnectLinkList" } } } } } }, "post": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewConnectLinkRequest" } } } }, "responses": { "201": { "description": "Created. The only response containing the URL", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatedConnectLink" } } } } } } },
    "/projects/{id}/connect-links/{linkId}": { "delete": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "linkId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Cancelled" } } } }
  },
  "components": {
    "schemas": {
      "SignupRequest": { "type": "object", "required": ["name", "company", "email", "password"], "properties": { "name": { "type": "string" }, "company": { "type": "string" }, "email": { "type": "string" }, "password": { "type": "string" } } },
      "LoginRequest": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string" }, "password": { "type": "string" } } },
      "Profile": {
        "type": "object", "required": ["user", "tenant", "projects"],
        "properties": {
          "user": { "type": "object", "required": ["id", "email", "name"], "properties": { "id": { "type": "string" }, "email": { "type": "string" }, "name": { "type": ["string", "null"] } } },
          "tenant": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } },
          "projects": { "type": "array", "items": { "type": "object", "required": ["id", "name", "isSandbox"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "isSandbox": { "type": "boolean" } } } }
        }
      },
      "ProjectOverview": {
        "type": "object", "required": ["project", "connections", "apiKeys"],
        "properties": {
          "project": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } },
          "connections": { "type": "object", "required": ["total", "active", "online", "tallyOpen"], "properties": { "total": { "type": "integer" }, "active": { "type": "integer" }, "online": { "type": "integer" }, "tallyOpen": { "type": "integer" } } },
          "apiKeys": { "type": "integer" }
        }
      },
      "Project": { "type": "object", "required": ["id", "name", "isSandbox"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "isSandbox": { "type": "boolean" } } },
      "NewProjectRequest": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } },
      "ApiKey": { "type": "object", "required": ["id", "name", "keyPrefix", "scopes", "createdAt", "lastUsedAt", "revokedAt"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "keyPrefix": { "type": "string" }, "scopes": { "type": "array", "items": { "type": "string" } }, "createdAt": { "type": "string" }, "lastUsedAt": { "type": ["string", "null"] }, "revokedAt": { "type": ["string", "null"] } } },
      "ApiKeyList": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/ApiKey" } } } },
      "NewApiKeyRequest": { "type": "object", "required": ["name", "scopes"], "properties": { "name": { "type": "string" }, "scopes": { "type": "array", "items": { "type": "string", "enum": ["read", "write", "admin"] } } } },
      "CreatedApiKey": { "type": "object", "required": ["id", "name", "keyPrefix", "scopes", "createdAt", "lastUsedAt", "revokedAt", "key"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "keyPrefix": { "type": "string" }, "scopes": { "type": "array", "items": { "type": "string" } }, "createdAt": { "type": "string" }, "lastUsedAt": { "type": ["string", "null"] }, "revokedAt": { "type": ["string", "null"] }, "key": { "type": "string" } } },
      "Connection": { "type": "object", "required": ["id", "status", "company", "createdAt", "connectorOnline", "tallyOpen", "lastSeenAt", "lastSyncAt", "schemaVersion"], "properties": { "id": { "type": "string" }, "status": { "type": "string", "enum": ["pending", "active", "paused", "revoked"] }, "company": { "type": ["string", "null"] }, "createdAt": { "type": "string" }, "connectorOnline": { "type": "boolean" }, "tallyOpen": { "type": "boolean" }, "lastSeenAt": { "type": ["string", "null"] }, "lastSyncAt": { "type": ["string", "null"] }, "schemaVersion": { "type": ["integer", "null"] } } },
      "ConnectionList": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Connection" } } } },
      "ConnectLink": { "type": "object", "required": ["id", "label", "requestedScopes", "status", "company", "createdAt", "expiresAt"], "properties": { "id": { "type": "string" }, "label": { "type": ["string", "null"] }, "requestedScopes": { "type": "array", "items": { "type": "string" } }, "status": { "type": "string", "enum": ["awaiting_connector", "awaiting_approval", "used", "expired"] }, "company": { "type": ["string", "null"] }, "createdAt": { "type": "string" }, "expiresAt": { "type": "string" } } },
      "ConnectLinkList": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/ConnectLink" } } } },
      "NewConnectLinkRequest": { "type": "object", "required": ["requestedScopes", "expiresInHours"], "properties": { "label": { "type": "string" }, "redirectUrl": { "type": "string" }, "requestedScopes": { "type": "array", "items": { "type": "string", "enum": ["read", "write"] } }, "expiresInHours": { "type": "integer" } } },
      "CreatedConnectLink": { "type": "object", "required": ["id", "url", "expiresAt"], "properties": { "id": { "type": "string" }, "url": { "type": "string" }, "expiresAt": { "type": "string" } } },
      "ApiError": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": {} } } } }
    }
  }
}
